---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import TrustBlock from "../components/TrustBlock.astro";
import FaqList from "../components/FaqList.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import { FERIA, hatDesigns, HAT_PRICES } from "../data/feria";
import { getProduct } from "../data/products";
import { cop } from "../consts";
import { designHero, designImages } from "../data/images";
import { faqsForProduct } from "../data/faqs";
import { productSchema, faqPage, breadcrumbList, serviceSchema } from "../lib/schema";

const product = getProduct("sombreros-brisa")!;
const url = new URL(Astro.url.pathname, Astro.site).href;
const faqs = faqsForProduct("sombreros-brisa");

// every real hat photo we have — fuels the gallery + Google Images
const allHatPhotos = hatDesigns.flatMap((d) =>
  designImages(d.slug).map((img) => ({ img, design: d })),
);

const title = "Sombreros para la Feria de las Flores pintados a mano | Luciptera";
const description = `Sombreros brisa blancos pintados a mano con flores antioqueñas para la Feria de las Flores de Medellín. Sombreros ya pintados listos para entrega inmediata por $80.000, o personalizados desde $100.000. Domicilio en Medellín y envíos a toda Colombia.`;
const waMsg = "Hola Luciptera 🌸 quiero un sombrero pintado para la Feria de las Flores";

const crumbs = [
  { name: "Inicio", href: "/" },
  { name: "Sombreros Feria de las Flores", href: "/sombreros-para-la-feria-de-las-flores/" },
];

// NOTE: no Event schema while the official 2027 dates are unannounced —
// we don't publish dates we can't verify. Re-add it via FERIA.datesConfirmed.
const jsonLd = [
  productSchema(product, url),
  serviceSchema(
    "Sombreros pintados a mano para la Feria de las Flores",
    description,
    url,
  ),
  breadcrumbList(crumbs.map((c) => ({ name: c.name, url: new URL(c.href, Astro.site).href }))),
  faqPage(faqs),
];

const infoLinks = [
  { href: "/sombreros-pintados-a-mano-medellin/", label: "Sombreros pintados a mano en Medellín" },
  { href: "/blog/cuando-es-la-feria-de-las-flores/", label: "¿Cuándo es la Feria de las Flores?" },
  { href: "/blog/que-llevar-a-la-feria-de-las-flores/", label: "Qué llevar a la feria" },
  { href: "/blog/flores-tipicas-de-la-feria-de-las-flores/", label: "Flores típicas de la feria" },
  { href: "/blog/que-es-una-silleta/", label: "¿Qué es una silleta?" },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} />

  <!-- HERO: photo-first, leads with hats available NOW -->
  <section class="container-base grid items-center gap-8 py-10 md:grid-cols-2">
    <div>
      <p class="font-head text-sm uppercase tracking-[0.25em] text-[var(--color-gold-deep)]">
        Feria de las Flores · Medellín
      </p>
      <h1 class="mt-3 font-head text-3xl font-bold leading-tight md:text-5xl">
        Sombreros pintados a mano para la Feria de las Flores
      </h1>
      <p class="mt-4 text-lg text-[var(--color-ink-soft)]">
        El clásico sombrero brisa blanco, convertido en arte: lo pintamos a mano con las flores
        más representativas de Antioquia. Domicilio en Medellín y envíos a toda Colombia.
      </p>

      <div class="mt-5 rounded-xl border border-[var(--color-gold)]/40 bg-[var(--color-gold)]/15 p-4">
        <p class="font-head font-bold">⚡ Sombreros disponibles HOY — {cop(HAT_PRICES.ready)}</p>
        <p class="mt-1 text-[15px]">
          Nos quedaron sombreros <strong>ya pintados de la feria</strong>, listos para llevar
          por <strong>{cop(HAT_PRICES.ready)}</strong> — sin esperar los días de pintura.
          Escríbenos y te mostramos cuáles están disponibles.
        </p>
      </div>

      <div class="mt-4 grid gap-2 sm:grid-cols-2">
        <div class="rounded-lg bg-white/70 p-3">
          <p class="text-lg font-bold">{cop(HAT_PRICES.ready)}</p>
          <p class="text-sm text-[var(--color-ink-soft)]">Ya pintados · entrega inmediata</p>
        </div>
        <div class="rounded-lg bg-white/70 p-3">
          <p class="text-lg font-bold">Desde {cop(HAT_PRICES.customFrom)}</p>
          <p class="text-sm text-[var(--color-ink-soft)]">Diseño personalizado · mín. 8 días</p>
        </div>
      </div>
      <div class="mt-5">
        <WhatsAppCTA message="Hola Luciptera 🌸 quiero ver los sombreros que tienes disponibles ya pintados" label="Ver sombreros disponibles" note="Te mandamos fotos de los que hay listos hoy." />
      </div>
    </div>

    <div>
      {hatDesigns.map((d) => designHero(d.slug)).filter(Boolean)[0] && (
        <Image
          src={hatDesigns.map((d) => designHero(d.slug)).filter(Boolean)[0]!}
          alt="Sombrero para la Feria de las Flores pintado a mano — sombrero brisa blanco con flores, Luciptera Medellín"
          width={760}
          height={760}
          widths={[420, 760]}
          sizes="(max-width: 768px) 100vw, 460px"
          class="card aspect-square w-full object-cover"
          loading="eager"
        />
      )}
    </div>
  </section>

  <!-- GALERÍA: todas las fotos reales (Google Images + prueba visual) -->
  {allHatPhotos.length > 0 && (
    <section class="container-base py-6">
      <h2 class="font-head text-2xl font-bold md:text-3xl">Nuestros sombreros pintados a mano</h2>
      <p class="mt-1 text-[var(--color-ink-soft)]">
        Fotos reales de sombreros que hemos pintado para la Feria de las Flores.
      </p>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {allHatPhotos.slice(0, 12).map(({ img, design }) => (
          <a href={`/${design.slug}/`} class="card block overflow-hidden">
            <Image
              src={img}
              alt={`Sombrero para la Feria de las Flores pintado a mano con ${design.flowers.slice(0, 2).join(" y ").toLowerCase()} — diseño ${design.name}, Luciptera Medellín`}
              width={420}
              height={420}
              widths={[260, 420]}
              sizes="(max-width: 640px) 45vw, 280px"
              class="aspect-square w-full object-cover transition-transform duration-300 hover:scale-105"
              loading="lazy"
            />
          </a>
        ))}
      </div>
      <div class="mt-5">
        <WhatsAppCTA message={waMsg} label="Quiero uno así 🌸" />
      </div>
    </section>
  )}

  <!-- DISEÑOS -->
  <section class="container-base py-6">
    <h2 class="font-head text-2xl font-bold md:text-3xl">Diseños para la feria</h2>
    <p class="mt-1 text-[var(--color-ink-soft)]">
      Elige uno de nuestros diseños o pide el tuyo. Cada sombrero se pinta a mano para ti.
    </p>
    <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3">
      {
        hatDesigns.map((d) => {
          const hero = designHero(d.slug);
          return (
            <a href={`/${d.slug}/`} class="card group block transition-transform hover:-translate-y-1">
              {hero ? (
                <Image
                  src={hero}
                  alt={`Sombrero ${d.name} — ${d.flowers.slice(0, 2).join(", ")}`}
                  width={420}
                  height={420}
                  widths={[260, 420]}
                  sizes="(max-width: 640px) 45vw, 280px"
                  class="aspect-square w-full object-cover"
                  loading="lazy"
                />
              ) : (
                <div class="flex aspect-square w-full flex-col items-center justify-center bg-gradient-to-br from-[var(--color-cream-deep)] to-[var(--color-glow)]/40 p-4 text-center">
                  <span class="text-5xl">{d.emoji}</span>
                  <p class="wordmark mt-2 text-2xl">{d.name}</p>
                </div>
              )}
              <div class="p-4">
                <h3 class="font-head text-base font-bold leading-snug">{d.name}</h3>
                <p class="mt-1 text-sm text-[var(--color-ink-soft)]">{d.short}</p>
              </div>
            </a>
          );
        })
      }
    </div>
    <p class="mt-4 text-xs text-[var(--color-ink-soft)]">
      ℹ️ Cada sombrero se pinta a mano, por lo que tu pieza es única y puede variar ligeramente del ejemplo.
    </p>
  </section>

  <!-- POR QUÉ LUCIPTERA / AUTORIDAD CULTURAL -->
  <section class="container-base py-8">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="card p-5">
        <h3 class="font-head text-lg font-bold">🎨 Arte real, no impresiones</h3>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">
          Cada flor se pinta a mano sobre el sombrero brisa. Tu pieza es única.
        </p>
      </div>
      <div class="card p-5">
        <h3 class="font-head text-lg font-bold">🌼 Flores de nuestra tierra</h3>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">
          Orquídea cattleya, hortensias de Santa Elena, girasoles y la silleta tradicional.
        </p>
      </div>
      <div class="card p-5">
        <h3 class="font-head text-lg font-bold">⚡ Entrega inmediata en la feria</h3>
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">
          Sombreros ya pintados, disponibles hoy con domicilio en Medellín. ¿Un diseño a tu gusto? También lo pintamos (mín. 8 días).
        </p>
      </div>
    </div>
  </section>

  <TrustBlock />

  <FaqList faqs={faqs} title="Preguntas sobre los sombreros de la feria" />

  <section class="container-base py-8">
    <div class="card bg-[var(--color-gold)]/10 p-6 text-center">
      <h2 class="font-head text-2xl font-bold">Luce único en la Feria de las Flores</h2>
      <p class="mt-2 text-[var(--color-ink-soft)]">
        Escríbenos por WhatsApp, elige tu diseño y nosotros lo pintamos a mano.
      </p>
      <div class="mt-4 flex justify-center">
        <WhatsAppCTA message={waMsg} label="Pedir ahora por WhatsApp" />
      </div>
    </div>
  </section>

  <RelatedLinks items={infoLinks} title="Sobre la Feria de las Flores" />
</Layout>

